{
  "name": "agent-buddy-workbuddy-windows",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "description": "Windows desktop pet for WorkBuddy with real-time task status, credit monitoring, tray controls, and a privacy-safe local plugin.",
  "license": "MIT",
  "homepage": "https://github.com/STFQ/agent-buddy-workbuddy-windows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STFQ/agent-buddy-workbuddy-windows.git"
  },
  "bugs": {
    "url": "https://github.com/STFQ/agent-buddy-workbuddy-windows/issues"
  },
  "keywords": [
    "workbuddy",
    "desktop-pet",
    "desktop-widget",
    "windows",
    "tauri",
    "rust",
    "typescript",
    "realtime-status",
    "credit-monitor",
    "system-tray"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "build:desktop-client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop-client.ps1",
    "package:desktop-client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-desktop-client.ps1",
    "version:desktop-client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-desktop-client-version.ps1",
    "tauri:build": "npm run build:desktop-client",
    "verify:desktop-client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-desktop-client-build.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
